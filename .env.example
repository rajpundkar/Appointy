# ─── App ────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Long random string — signs session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-hex-string

# ─── Turso (libSQL) ─────────────────────────────────────────────────────
# Create a DB at https://turso.tech → copy the URL and an auth token
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# ─── Resend (email) ─────────────────────────────────────────────────────
# Create an API key at https://resend.com/api-keys
# Verify appointy.xyz in Resend → Domains (add DKIM/SPF/DMARC TXT records to DNS)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Appointy <hello@yourdomain.com>"

# ─── Google (Calendar + Meet) ───────────────────────────────────────────
# Cloud Console → enable "Google Calendar API" + create OAuth 2.0 Client.
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft (Teams) ──────────────────────────────────────────────────
# Azure → App registrations. Permissions: User.Read, OnlineMeetings.ReadWrite, Calendars.ReadWrite
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
